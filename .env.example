# Copy to `.env`. TRUST_PROXY and BLOCK_INTERNAL_URLS must be exactly 0 or 1.
# DATABASE_URL is for host runs (`npm run dev` / `npm start`); `docker compose up`
# overrides it inside the `web` container via docker-compose.yml.

PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urlshortener

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urlshortener

PUBLIC_BASE_URL=http://localhost:3000

ADMIN_TOKEN=change-me-to-a-long-random-secret

TRUST_PROXY=0

BLOCK_INTERNAL_URLS=0
